/*
  # React currently renders many inline style attributes, so style-src needs unsafe-inline.
  # The JSON-LD block in index.html is allow-listed by hash to keep script-src otherwise strict.
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; frame-src 'none'; form-action 'self'; manifest-src 'self'; img-src 'self' data:; font-src 'self' https://fonts.gstatic.com data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self' 'sha256-QDVkoEeTjos5UkaZRHI4Y18GTGQ0A2n6fD+Q2h4PBOs='; connect-src 'self' https://*.supabase.co wss://*.supabase.co
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), autoplay=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()

/account
  X-Robots-Tag: noindex, nofollow

/account/*
  X-Robots-Tag: noindex, nofollow

/profile
  X-Robots-Tag: noindex, nofollow

/profile/*
  X-Robots-Tag: noindex, nofollow

/settings
  X-Robots-Tag: noindex, nofollow

